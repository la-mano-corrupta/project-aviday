# Copy to .env (never commit .env!)
# Supports up to 7 (or more) Gemini API keys for automatic round-robin + 429/503 rotation:
GEMINI_API_KEYS=
# Or set individual keys:
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
# GEMINI_API_KEY_5=
# GEMINI_API_KEY_6=
# GEMINI_API_KEY_7=

# Optional model overrides:
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# Optional remote worker proxy if you host your key pool in Cloudflare Workers:
# GEMINI_WORKER_URL=

# Optional Chrome path override for headless capture:
# CHROME=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
