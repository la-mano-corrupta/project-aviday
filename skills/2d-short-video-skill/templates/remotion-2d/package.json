{
  "name": "philosophy-2d-remotion",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "still": "remotion still src/index.ts Main out/still.png",
    "cover:3x4": "remotion still src/index.ts Cover3x4 out/cover-3x4.jpg --image-format=jpeg",
    "render": "remotion render src/index.ts Main out/final.mp4 --crf=16 --gl=angle",
    "render:sw": "remotion render src/index.ts Main out/final.mp4 --crf=16 --gl=swangle"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "^5.6.0"
  }
}
