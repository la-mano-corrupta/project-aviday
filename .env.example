# ==============================================================================
# project-aviday — Environment Configuration Example
# Copy to .env and fill in ONLY the features you want to use.
# Video generation works offline/locally even if ALL social keys are blank!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Script & Gemini TTS (Optional: --script / template fallback works without it)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="YOUR_GOOGLE_AI_STUDIO_API_KEY"
# Optional comma-separated pool for rotation:
GEMINI_API_KEYS=""
GEMINI_TTS_VOICE="Kore"

# ------------------------------------------------------------------------------
# 2. Voice / TTS Provider Selection
# ------------------------------------------------------------------------------
# Options: default | kokoro | gemini | elevenlabs
# "default" uses local Kokoro TTS if installed, falling back to edge-tts.
TTS_PROVIDER="default"
TTS_VOICE=""

# Provider-specific voice / key overrides (only needed if using that provider):
KOKORO_VOICE="af_heart"
EDGE_TTS_VOICE="en-US-AndrewNeural"
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""

# ------------------------------------------------------------------------------
# 3. Video Rendering Options (Local macOS/Linux & Headless Linux CI)
# ------------------------------------------------------------------------------
FPS="24"
# Set SOFTWARE_GL=1 on headless Linux / VMs without a GPU (e.g. GitHub Actions):
SOFTWARE_GL=""
QS=""
CHROME=""
FACELESS_HOME=""
PROJECTS_DIR=""

# ------------------------------------------------------------------------------
# 4. Social Uploaders (Optional — skipped cleanly if unset or --no-upload used)
# ------------------------------------------------------------------------------
# Instagram / Meta Graph API v22.0
META_PAGE_ACCESS_TOKEN=""
IG_BUSINESS_ACCOUNT_ID=""
FB_PAGE_ID=""
META_VERIFY_TOKEN="CHANGE_ME_VERIFY_TOKEN"

# Public video hosting for Instagram Reels API (optional)
PUBLIC_VIDEO_BASE_URL=""
LITTERBOX_UPLOAD="1"

# YouTube Data API v3 (Shorts)
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REFRESH_TOKEN=""

# ------------------------------------------------------------------------------
# 5. Optional 24/7 Cloudflare Worker & IG DM Agent
# ------------------------------------------------------------------------------
AVIDAY_WORKER_URL=""
AVIDAY_HANDLE=""
OWNER_NAME="YOUR_NAME"
AGENT_NAME="Aviday"
ADMIN_1_USERNAME=""
